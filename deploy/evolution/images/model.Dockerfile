FROM docker.io/ollama/ollama@sha256:31650ae0d08bde9c8bbd845d27f2da31acddf6ff735523869d8e5ee7a9969b03
ARG MODEL_DIRECTORY
COPY --chown=10001:10001 ${MODEL_DIRECTORY}/ /models/
ENV OLLAMA_HOST=127.0.0.1:11434 OLLAMA_MODELS=/models OLLAMA_NO_CLOUD=1 OLLAMA_NUM_PARALLEL=1 OLLAMA_MAX_LOADED_MODELS=1 OLLAMA_CONTEXT_LENGTH=2048 HOME=/state
USER 10001:10001
ENTRYPOINT ["/bin/ollama"]
CMD ["serve"]
