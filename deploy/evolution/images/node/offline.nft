add table inet evolution_offline
flush table inet evolution_offline
table inet evolution_offline {
  set local4 {
    type ipv4_addr
    flags interval
    elements = { 127.0.0.1/32, 192.168.51.2/32, 10.244.0.0/16, 10.96.0.0/12 }
  }
  chain output {
    type filter hook output priority 300; policy drop;
    ip daddr @local4 counter accept
    ip6 daddr ::1 counter accept
    ct state established,related ip daddr 192.168.51.1 counter accept
    counter drop
  }
  chain forward {
    type filter hook forward priority 300; policy drop;
    ip daddr @local4 counter accept
    ip6 daddr ::1 counter accept
    counter drop
  }
}
