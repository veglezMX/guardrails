#!/bin/sh
set -eu
# This executes only in the task-owned Docker node's separate network namespace.
# One atomic nft transaction installs the barrier before kicbase starts systemd.
/usr/sbin/nft -f /usr/local/share/evolution-offline.nft
unset HTTP_PROXY HTTPS_PROXY ALL_PROXY NO_PROXY http_proxy https_proxy all_proxy no_proxy
exec /usr/local/bin/entrypoint "$@"
