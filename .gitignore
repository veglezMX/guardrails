.direnv/
result
result-*
__pycache__/
*.pyc

# audit stream written by the local runtime — regenerate with `just demo`
mvp/deployment/audit.jsonl

# built presentation, workbook and document artifacts — regenerate with
# `just deck-all` / `just xlsx-all` / `just docx-all`
/presentations/
*.pptx
*.xlsx
*.docx

!assets/*pptx
!assets/*xlsx
!assets/*docx
# stray Python packaging output — nix owns the toolchain, so a wheel or a venv
# in the tree is always something that leaked out of an ad-hoc command
*.whl
.venv/

# Prepared local proof artifacts, credentials and environments
.proof/
*.egg-info/
.pytest_cache/
build/

# Task-owned evolution environments, mounted secrets, state and signed reports
.evolution/
.ruff_cache/

# Local Kubernetes discovery cache and codebase index
/.kube/
/.codebase-memory/
