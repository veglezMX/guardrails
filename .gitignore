result
result-*
__pycache__/
*.pyc

# built presentation and workbook artifacts — regenerate with `just deck-all` /
# `just xlsx-all`
/presentations/
*.pptx
*.xlsx

!assets/*pptx
!assets/*xlsx
# stray Python packaging output — nix owns the toolchain, so a wheel or a venv
# in the tree is always something that leaked out of an ad-hoc command
*.whl
.venv/
